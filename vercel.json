{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "env": {
    "KC_DEMO_SEED": "1",
    "EMBEDDING_FAKE": "1",
    "LLM_FAKE_RESPONSE": "Walk gently into this week. What you named is worth one more honest paragraph."
  }
}
